# URL de la implementacion del Apps Script (termina en /exec, no en /dev)
VITE_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Site key publica de Cloudflare Turnstile.
# Si se deja vacia, el widget no se monta y el formulario funciona igual
# (util en local). En produccion tiene que estar cargada.
VITE_TURNSTILE_SITE_KEY=

# Token compartido con el Apps Script. NO es un secreto: viaja en el bundle
# y cualquiera lo lee con el inspector. Solo frena bots ingenuos.
VITE_FORM_TOKEN=cambiar-esto

